###############################################################
# Environment settings for OSM2PGSQL import
#
# variables defined here will be imported to Docker containers as environment variables, provided that they are mentionned in docker-compose.yml
###############################################################

#------------------- technical tuning --------------------

# osm2pgsql tuning
OSM2PGSQL_CACHE=512   # MB of cache
OSM2PGSQL_NUMPROC=1   # number of parallel workers

#----------------- project parameters -----------------------

# source to use for downloading contours from viewfinderpanoramas.org
# Can be a comma-separated list for fallback, e.g. "view1,view3" will use
# high-res view1 where available and fall back to lower-res view3 elsewhere
#AREAPOLYSOURCE=view1   #  1 second arc resolution ( not available for all countries)
#AREAPOLYSOURCE=view3  #  3 seconds arc resolution ( for countries having no data on view1 )
AREAPOLYSOURCE=view1,view3  #  prefer view1, fallback to view3


# my favorite area
AREAOSM=rhone-alpes.osm.pbf
AREAPOLY=rhone-alpes.poly


# small data for andorra
AREAOSM=andorra.osm.pbf        # osm.pbf file 
AREAPOLY=andorra.poly   # polygon for importing contours

# france
AREAOSM=france.osm.pbf
AREAPOLY=france.poly

#------------------ final choice --------------------

# Optional: high-resolution area: defines the extent rendered at zoom 11 and above.
# File format: a single line containing  minlon,minlat,maxlon,maxlat
# Used for two purposes:
#   1. The contours DB is clipped to this bbox + 0.5° buffer (via osmium extract)
#      so the DB stays small — contours are only displayed from zoom 12 onwards.
#   2. The tile-export --bounds value is derived from this file via bbox_buffer.sh.
#      See the "Export tiles" section of README.md.
# When unset, the full AREAPOLY contour data is imported without clipping.
HIGHRESAREABBOX=wrf-domain.bbox



AREAOSM=andorra.osm.pbf
AREAPOLY=andorra.poly



